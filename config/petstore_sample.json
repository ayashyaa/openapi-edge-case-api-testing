{
  "openapi": "3.0.0",
  "info": {
    "title": "Sample Petstore API",
    "version": "1.0.0"
  },
  "paths": {
    "/users": {
      "post": {
        "summary": "Create User",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "age"],
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 20
                  },
                  "age": {
                    "type": "integer",
                    "minimum": 18,
                    "maximum": 99
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" },
          "400": { "description": "Invalid Input" }
        }
      }
    }
  }
}